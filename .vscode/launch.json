{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview website",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Run regression tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--test"
      ],
      "program": "${workspaceFolder}/tests/audit.test.cjs",
      "console": "integratedTerminal"
    }
  ]
}
