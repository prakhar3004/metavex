{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/metavex/browser",
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/comparison",
      "destination": "/comparison/index.html"
    },
    {
      "source": "/calculator",
      "destination": "/calculator/index.html"
    },
    {
      "source": "/case-studies",
      "destination": "/case-studies/index.html"
    },
    {
      "source": "/process",
      "destination": "/process/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "functions": {
    "api/leads.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "destination": "https://metavex.design/:path*",
      "permanent": true,
      "source": "/:path*",
      "has": [
        {
          "value": "www.metavex.design",
          "type": "host"
        }
      ]
    }
  ]
}
