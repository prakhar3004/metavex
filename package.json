{
  "name": "metavex",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build && node scripts/verify-seo.mjs",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && node --check api/leads.mjs && node --check scripts/serve-leads-api.mjs && node --check scripts/indexnow.mjs",
    "test": "node --test tests/audit.test.cjs tests/leads-api.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "api": "node --env-file-if-exists=.env.local scripts/serve-leads-api.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "21.2.27",
    "rxjs": "~7.8.0",
    "three": "^0.183.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@<7.1.6": "7.1.6"
    }
  }
}
